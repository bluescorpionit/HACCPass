<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Blue Haccp</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>blue_haccp</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- Permessi: testi in italiano, specifici e onesti, mostrati al momento
	     dell'uso. Il permesso notifiche si chiede a runtime. -->
		<key>NSCameraUsageDescription</key>
		<string>Scatta foto di attrezzature, DDT, non conformità e scansiona i QR delle attrezzature.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Scegli foto di attestati, etichette e documenti da allegare ai registri.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Salva le foto e i PDF dei registri nella tua libreria foto.</string>
		<key>NSContactsUsageDescription</key>
		<string>Importa i fornitori dai contatti del telefono: solo se lo scegli tu.</string>
		<!-- Google Sign-In (solo archivio Drive, non accesso all'app):
	     inserire il reversed client ID del progetto Google Cloud. -->
